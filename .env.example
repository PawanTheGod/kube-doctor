# Copy to .env and fill in. Never commit real keys.

# Gemini backend (default) — Gemma 4 via Gemini API.
GEMINI_API_KEY=
# Model id is intentionally not hardcoded; look it up in the Gemini API model list.
KUBE_DOCTOR_MODEL=gemma-4-26b-a4b-it

# OpenAI-compatible backend (Ollama, vLLM, llama.cpp server, LM Studio).
KUBE_DOCTOR_BASE_URL=http://localhost:11434/v1
KUBE_DOCTOR_API_KEY=
# Vision-capable model served by the local endpoint (Gemma 4).
# Uncomment to use local backend instead — do not set both KUBE_DOCTOR_MODEL lines.
# KUBE_DOCTOR_MODEL=gemma4:e4b

# Seconds per request. Vision models are slow to start, so this is generous.
KUBE_DOCTOR_TIMEOUT=120
# Optional second model, tried once if the primary is unavailable after 5 attempts.
# Leave empty to disable; a diagnosis produced this way is labelled as such.
KUBE_DOCTOR_FALLBACK_MODEL=
